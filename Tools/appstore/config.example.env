# Скопируйте в Tools/appstore/config.env (файл не попадает в git) и впишите свои значения.
# Идентификатор команды разработчика Apple (Membership → Team ID):
DEVELOPMENT_TEAM=XXXXXXXXXX
# Ключ App Store Connect API (Users and Access → Integrations). Сам ключ .p8 лежит вне репозитория:
# ~/.appstoreconnect/private_keys/AuthKey_<ASC_KEY_ID>.p8
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
